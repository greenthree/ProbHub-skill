{
  "name": "probhub-skill",
  "version": "0.6.0",
  "description": "Lightweight ProbHub command package that delegates to the complete probhub package.",
  "main": "bin/init.js",
  "bin": {
    "probhub-skill": "bin/init.js",
    "probhub": "bin/probhub.js"
  },
  "scripts": {
    "check": "node --check bin/init.js && node --check bin/probhub.js",
    "prepublishOnly": "npm run check && python ../../scripts/check_release.py --pack --require-head-tag --require-clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenthree/ProbHub-skill.git"
  },
  "keywords": [
    "acm",
    "icpc",
    "problem-setting",
    "probhub",
    "compatibility"
  ],
  "author": "greenthree",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/greenthree/ProbHub-skill/issues"
  },
  "homepage": "https://github.com/greenthree/ProbHub-skill#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "probhub": "0.6.0"
  },
  "files": [
    "bin/*.js",
    "README.md",
    "LICENSE"
  ]
}
