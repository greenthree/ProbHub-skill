{
  "name": "probhub-skill",
  "version": "0.3.0",
  "description": "基于大语言模型 (LLM Agent) 和现代排版框架构建的 ACM/ICPC 自动化出题工作流。",
  "main": "bin/init.js",
  "bin": {
    "probhub-skill": "bin/init.js",
    "probhub": "bin/probhub.js"
  },
  "scripts": {
    "test": "python -m unittest discover -s tests -v",
    "check": "python -m compileall -q probhub scripts tests && python -m probhub --version && node --check bin/init.js && node --check bin/probhub.js && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenthree/ProbHub-skill.git"
  },
  "keywords": [
    "acm",
    "icpc",
    "problem-setting",
    "typst",
    "cyaron",
    "agent",
    "claude"
  ],
  "author": "greenthree",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/greenthree/ProbHub-skill/issues"
  },
  "homepage": "https://github.com/greenthree/ProbHub-skill#readme",
  "dependencies": {
    "fs-extra": "^11.3.5"
  },
  "files": [
    "bin/*.js",
    "SKILL.md",
    "references/**",
    "scripts/*.py",
    "probhub/**/*.py"
  ]
}
